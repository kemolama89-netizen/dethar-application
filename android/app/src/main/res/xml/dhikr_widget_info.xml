<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis 0: the widget never wakes the phone on its own. It is
     redrawn when a reminder arrives, when settings change, and at the next
     time-of-day change (a non-waking alarm) — see RemindersScheduler. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="80dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_dhikr"
    android:previewLayout="@layout/widget_dhikr"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/widget_description"
    android:widgetCategory="home_screen" />
