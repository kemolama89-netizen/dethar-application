<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Floating Tasbeeh (Phase 2) — see the feature plan. Not
             exported: only started from within this app (Settings toggle,
             the boot receiver, or the service's own restart). -->
        <service
            android:name=".floatingtasbeeh.FloatingTasbeehService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the user's live Tasbeeh count in a small floating bubble over other apps, so they can keep counting without switching back to DITHAR." />
        </service>

        <receiver
            android:name=".floatingtasbeeh.BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Required on Android 11+ (API 30+) package-visibility rules for
         android.speech.SpeechRecognizer.isRecognitionAvailable()/binding
         to actually find and use an installed RecognitionService (e.g.
         Google's) — see VoiceRecognitionPlugin.kt, the native replacement
         for the browser Web Speech API used by Voice Tasbeeh on Android
         (the embedded WebView accepts a SpeechRecognition session but
         never engages its recognition backend — confirmed via the
         temporary pipeline diagnostic; this queries block/plugin do not
         touch that WebView-based fallback, which stays in place for the
         plain web/browser build). Without this, isRecognitionAvailable()
         can incorrectly report false / binding can silently fail on
         Android 11+, regardless of whether a recognition service is
         actually installed. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required for the WebView's own navigator.geolocation grant (see
         useCoordinates.ts) to ever succeed at all — without these declared,
         Android's BridgeWebChromeClient.onGeolocationPermissionsShowPrompt
         (@capacitor/android) denies the fix outright with no runtime
         prompt shown, regardless of what the JS side requests. Same
         "must be declared or Capacitor can't even ask" rule as
         RECORD_AUDIO below. COARSE is enough for prayer-time-accuracy
         GPS; FINE is included since the OS runtime prompt bundles both
         into one dialog and either grant satisfies the WebView check. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Floating Tasbeeh (Phase 2) permissions — see the feature plan for
         why each is needed and what Play Store review implications they
         carry. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Short haptic pulse on a valid manual tap (FloatingTasbeehService's
         own triggerHapticFeedback) — a dangerous-permission-free, normal
         protection-level permission, granted automatically at install. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Required for the WebView's own SpeechRecognition/getUserMedia grant
         to ever succeed at all — without this declared, Android denies the
         mic outright with no prompt, regardless of what Capacitor's Bridge
         requests at runtime. Needed for the main Tasbeeh screen's own
         Voice Tasbeeh (useVoiceTasbeeh.ts) to function in the packaged
         Android app — unrelated to Floating Tasbeeh, which has no voice
         input of its own. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Capacitor's own BridgeWebChromeClient.onPermissionRequest requests
         this ALONGSIDE RECORD_AUDIO (as one combined runtime request)
         whenever the WebView asks for "android.webkit.resource.AUDIO_CAPTURE"
         (which SpeechRecognition.start() triggers) — see
         node_modules/@capacitor/android/.../BridgeWebChromeClient.java.
         Its callback only reports the whole request as granted if EVERY
         requested permission comes back granted; an undeclared permission
         is auto-denied by Android with no prompt at all, which made that
         combined check always fail and silently deny microphone access to
         the WebView regardless of the user's actual RECORD_AUDIO choice.
         Declaring it here (a "normal" protection-level permission, granted
         automatically — no separate runtime prompt of its own) closes that
         gap. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
